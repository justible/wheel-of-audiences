{
  "name": "wheel-of-audiences-api",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "CLASSROOMS",
        "class_name": "Classrooms"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Classrooms"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://justible.github.io,http://127.0.0.1:4319,http://localhost:4319"
  }
}
